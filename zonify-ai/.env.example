# Your Google Gemini API Key (Required for the generative AI features)
GEMINI_API_KEY=your_google_gemini_api_key_here

# --- Flask Server Configuration ---
# The entry point of your application
FLASK_APP=app.py

# Set to 'development' for local debugging, or 'production' for live deployment
FLASK_ENV=development

# The port your app runs on (7860 is the Hugging Face Docker default)
PORT=7860
TF_ENABLE_ONEDNN_OPTS=0